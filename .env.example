# Google Gemini API Key for blog generation and topic research
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Brand Preset (defaults to 'el_laundry' or 'default')
BLOG_TOOLKIT_PRESET=el_laundry

# Optional: Output destination path for Next.js TypeScript sync
BLOG_TOOLKIT_SYNC_PATH=../el-laundry-site/src/lib/blog/posts.ts
